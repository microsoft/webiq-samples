# Copia este fichero a .env y añade tu clave de Web IQ (portal: https://webiq.microsoft.ai/profiles).
# .env está en .gitignore: la clave no se sube al repositorio y nunca llega al navegador.
WEBIQ_API_KEY=

# Caso 0 · modelo que planifica las búsquedas y redacta la respuesta (endpoint compatible con OpenAI v1).
# Sin LLM_API_KEY se usa Entra ID: tu sesión de Azure CLI en local o la identidad administrada en Azure.
# LLM_ENDPOINT=https://<recurso>.cognitiveservices.azure.com/openai/v1
# LLM_MODEL=gpt-5.4-mini
# LLM_API_KEY=

# Caso 0 · protección al publicar la demo
# LIVE_ACCESS_CODE=elige-un-codigo
# TRUST_PROXY=1            # detrás de App Service u otro proxy (IP del visitante en X-Forwarded-For)
# LIVE_PER_MINUTE=6
# LIVE_DAILY_LIMIT=200
# LIVE_MAX_CONCURRENT=4
# Cada llamada individual del proxy también se limita (compartido por web/news/images/videos/browse/auto):
# WEBIQ_PROXY_PER_MINUTE=8
# WEBIQ_PROXY_DAILY_LIMIT=200
# WEBIQ_PROXY_MAX_CONCURRENT=8

# Caso 6 · agente de Foundry en vivo (Foundry IQ + Web IQ). Token de Entra ID: tu sesión de Azure CLI en local
# o la identidad administrada en Azure, con el rol «Foundry User» (antes «Azure AI User») en el recurso de Foundry.
# FOUNDRY_PROJECT_ENDPOINT=https://<recurso>.services.ai.azure.com/api/projects/<proyecto>
# FOUNDRY_AGENT=revisor-contratos-telco
# FOUNDRY_PER_MINUTE=2
# FOUNDRY_DAILY_LIMIT=60
# FOUNDRY_MAX_CONCURRENT=2

# Aprovisionamiento opcional de Foundry IQ/agente y carga de la clave en Azure.
# Se requieren estos valores para apuntar explícitamente a tus recursos; el código no contiene destinos predeterminados.
# AZURE_SUBSCRIPTION_ID=
# AZ_RESOURCE_GROUP=
# AZ_WEBAPP=
# AZ_APP_SERVICE_PLAN=
# AZ_WEBAPP_URL=                    # Solo si la Web App usa un dominio personalizado
# DOCS_PUBLIC_BASE=https://<tu-webapp>.azurewebsites.net
# FOUNDRY_RESOURCE_GROUP=
# FOUNDRY_ACCOUNT=
# FOUNDRY_PROJECT=
# FOUNDRY_PROJECT_MI_OBJECT_ID=
# SEARCH_RESOURCE_GROUP=
# SEARCH_SERVICE=

# Web IQ con Entra ID en lugar de clave (identidad administrada vinculada en el portal o aplicación propia)
# WEBIQ_AUTH=entra
# WEBIQ_APPID=
# WEBIQ_TENANT_ID=
# WEBIQ_CLIENT_ID=
# WEBIQ_CLIENT_SECRET=

# Opcional
# WEBIQ_BASE_URL=https://api.microsoft.ai/v3
# PORT=8787
# HOST=127.0.0.1
# Nombres de host extra para abrir la demo desde otro equipo (además de localhost y las IP):
# WEBIQ_ALLOWED_HOSTS=mi-portatil.local
